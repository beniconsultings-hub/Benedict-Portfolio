/*==========================================
    RESET
==========================================*/
*{
    margin:0;
    padding:0;
    box-sizing:border-box;
}
html{
   scroll-behavior:smooth;
}
body{
    background:#090909;
    color:#ffffff;
    font-family:'Inter',sans-serif;
    overflow-x:hidden;
    line-height:1.8;
}
img{
    width:100%;
    display:block;
}
a{
    text-decoration:none;
    color:inherit;
}
ul{
    list-style:none;
}
button,
input,
textarea{
    font-family:inherit;
    outline:none;
    border:none;
}
.container{
    width:min(1180px,92%);
    margin:auto;
}
.section{
    padding:120px 0;
}
/*==========================================
    COLORS
==========================================*/
:root{
--bg:#090909;
--card:#111111;
--gold:#d4af37;
--white:#ffffff;
--gray:#9d9d9d;
--line:#222222;
--radius:20px;
--transition:.35s ease;
}
/*==========================================
    CUSTOM SCROLLBAR
==========================================*/
::-webkit-scrollbar{
    width:8px;
}
::-webkit-scrollbar-thumb{
    background:var(--gold);
}
::-webkit-scrollbar-track{
    background:#111;
}
/*==========================================
    HEADER
==========================================*/
header{
position:fixed;
top:0;
left:0;
width:100%;
z-index:999;
backdrop-filter:blur(18px);
background:rgba(9,9,9,.75);
border-bottom:1px solid rgba(255,255,255,.06);
}
.nav-container{
height:90px;
display:flex;
align-items:center;
justify-content:space-between;
}
.logo{
font-family:'Space Grotesk',sans-serif;
font-size:26px;
font-weight:700;
letter-spacing:2px;
}
nav ul{
display:flex;
gap:45px;
}
nav a{
color:#ddd;
transition:.3s;
}
nav a:hover{
color:var(--gold);
}
.nav-btn{
padding:15px 28px;
background:var(--gold);
color:#111;
border-radius:100px;
font-weight:600;
transition:.3s;
}
.nav-btn:hover{
transform:translateY(-4px);
}

/*==========================================
    HERO
==========================================*/
.hero{
padding-top:180px;
padding-bottom:140px;
position:relative;
}
.hero-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:90px;
align-items:center;
}
.hero-tag{
display:inline-block;
padding:8px 18px;
border:1px solid rgba(255,255,255,.08);
border-radius:50px;
color:var(--gold);
font-size:14px;
letter-spacing:2px;
margin-bottom:30px;
}
.hero h1{
font-family:'Space Grotesk';
font-size:72px;
line-height:1.08;
margin-bottom:28px;
}
.hero h1 span{
color:var(--gold);
}
.hero p{
font-size:19px;
color:#bdbdbd;
max-width:600px;
margin-bottom:45px;
}
.hero-buttons{
display:flex;
gap:20px;
margin-bottom:60px;
}
.primary-btn{
padding:18px 36px;
background:var(--gold);
border-radius:70px;
font-weight:700;
color:#111;
transition:.35s;
}
.primary-btn:hover{
transform:translateY(-5px);
}
.secondary-btn{
padding:18px 36px;
border-radius:70px;
border:1px solid rgba(255,255,255,.15);
transition:.35s;
}
.secondary-btn:hover{
background:#fff;
color:#111;
}
.hero-stats{
display:flex;
gap:50px;
}
.hero-stats h2{
font-size:45px;
font-family:'Space Grotesk';
margin-bottom:8px;
}
.hero-stats span{
color:#9f9f9f;
font-size:15px;
}
.image-wrapper{
position:relative;
}
.image-wrapper img{
border-radius:30px;
border:1px solid rgba(255,255,255,.08);
}
.floating-card{
position:absolute;
background:#111;
padding:18px;
display:flex;
gap:18px;
align-items:center;
border-radius:18px;
border:1px solid rgba(255,255,255,.07);
box-shadow:0 20px 60px rgba(0,0,0,.4);
}
.floating-card i{
font-size:28px;
color:var(--gold);
}
.floating-card.top{
top:40px;
left:-60px;
}
.floating-card.bottom{
bottom:40px;
right:-60px;
}
.scroll-indicator{
position:absolute;
left:50%;
bottom:30px;
transform:translateX(-50%);
display:flex;
flex-direction:column;
align-items:center;
gap:8px;
color:#999;
animation:float 2s infinite;
}
@keyframes float{
50%{
transform:translate(-50%,10px);
}
}
/*==========================================
SECTION TITLES
==========================================*/
.section-heading{
margin-bottom:70px;
}
.section-heading span{
color:var(--gold);
font-size:14px;
letter-spacing:3px;
display:block;
margin-bottom:18px;
}
.section-heading h2{
font-size:54px;
font-family:'Space Grotesk';
margin-bottom:20px;
}
.section-heading p{
max-width:650px;
color:#aaa;
}
/*==========================================
PROJECTS
==========================================*/
.projects{
display:flex;
flex-direction:column;
gap:120px;
}
.project-card{
display:grid;
grid-template-columns:1fr 1fr;
gap:70px;
align-items:center;
}
.project-card.reverse{
direction:rtl;
}
.project-card.reverse>*{
direction:ltr;
}
.project-image{
overflow:hidden;
border-radius:24px;
}
.project-image img{
transition:.7s;
}
.project-card:hover img{
transform:scale(1.06);
}
.project-content span{
color:var(--gold);
font-size:13px;
letter-spacing:2px;
}
.project-content h3{
font-size:42px;
margin:20px 0;
font-family:'Space Grotesk';
}
.project-content p{
color:#aaa;
margin-bottom:30px;
}
.project-content ul{
display:grid;
grid-template-columns:repeat(2,1fr);
gap:15px;
margin-bottom:35px;
}
.project-content li{
background:#111;
padding:15px;
border-radius:12px;
border:1px solid #1f1f1f;
}


/*==========================================
SERVICES
==========================================*/

.services-grid{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:30px;
}
.service-box{
background:var(--card);
padding:45px 35px;
border-radius:var(--radius);
border:1px solid var(--line);
transition:var(--transition);
position:relative;
overflow:hidden;
}
.service-box::before{
content:"";
position:absolute;
left:0;
top:0;
width:100%;
height:4px;
background:var(--gold);
transform:scaleX(0);
transition:.4s;
transform-origin:left;
}
.service-box:hover::before{
transform:scaleX(1);
}
.service-box:hover{
transform:translateY(-12px);
border-color:rgba(212,175,55,.4);
box-shadow:0 25px 60px rgba(0,0,0,.45);
}
.service-box i{
font-size:40px;
color:var(--gold);
margin-bottom:25px;
}
.service-box h3{
font-family:'Space Grotesk';
font-size:26px;
margin-bottom:15px;
}
.service-box p{
color:#aaaaaa;
line-height:1.8;
}
/*==========================================
PROCESS
==========================================*/
.timeline{
display:grid;
grid-template-columns:repeat(4,1fr);
gap:35px;
margin-top:60px;
}
.step{
background:var(--card);
padding:45px 30px;
border-radius:24px;
border:1px solid var(--line);
transition:var(--transition);
}
.step:hover{
transform:translateY(-10px);
}
.step h1{
font-size:65px;
font-family:'Space Grotesk';
color:rgba(212,175,55,.18);
margin-bottom:18px;
}
.step h4{
font-size:24px;
margin-bottom:15px;
}
.step p{
color:#9d9d9d;
}
/*==========================================
ABOUT
==========================================*/
.about-grid{
display:grid;
grid-template-columns:1fr 1fr;
gap:90px;
align-items:center;
}
.about-image img{
border-radius:28px;
border:1px solid rgba(255,255,255,.08);
}
.about-content span{
color:var(--gold);
letter-spacing:3px;
font-size:14px;
}
.about-content h2{
font-family:'Space Grotesk';
font-size:58px;
line-height:1.1;
margin:22px 0;
}
.about-content p{
color:#aaaaaa;
margin-bottom:45px;
font-size:18px;
}

/*==========================================
TESTIMONIALS
==========================================*/
.testimonial-grid{
display:grid;
grid-template-columns:repeat(3,1fr);
gap:35px;
}
.testimonial-card{
background:var(--card);
padding:40px;
border-radius:24px;
border:1px solid var(--line);
transition:var(--transition);
}
.testimonial-card:hover{
transform:translateY(-10px);
}
.testimonial-card i{
font-size:42px;
color:var(--gold);
margin-bottom:25px;
}
.testimonial-card p{
color:#b0b0b0;
margin-bottom:35px;
}
.client{
display:flex;
align-items:center;
gap:18px;
}
.client img{
width:65px;
height:65px;
border-radius:50%;
object-fit:cover;
}
.client h4{
margin-bottom:4px;
}
.client span{
font-size:14px;
color:#8f8f8f;
}

/*==========================================
CTA
==========================================*/
.cta{
padding:140px 0;
}
.cta-box{
background:linear-gradient(135deg,#151515,#0d0d0d);
padding:90px 70px;
text-align:center;
border-radius:30px;
border:1px solid rgba(255,255,255,.06);
}
.cta-box span{
color:var(--gold);
letter-spacing:3px;
font-size:14px;
}
.cta-box h2{
font-family:'Space Grotesk';
font-size:60px;
margin:25px auto;
max-width:800px;
}
.cta-box p{
max-width:650px;
margin:0 auto 45px;
color:#aaaaaa;
}

/*==========================================
CONTACT
==========================================*/
.contact-form{
max-width:900px;
margin:auto;
}
.input-group{
display:grid;
grid-template-columns:1fr 1fr;
gap:25px;
margin-bottom:25px;
}
.contact-form input,
.contact-form textarea{
width:100%;
background:#111111;
padding:22px;
color:#ffffff;
border:1px solid #222;
border-radius:16px;
margin-bottom:25px;
transition:.3s;
}
.contact-form input:focus,
.contact-form textarea:focus{
border-color:var(--gold);
}
.contact-form textarea{
resize:none;
}
/*==========================================
FOOTER
==========================================*/
footer{
padding:80px 0 40px;
border-top:1px solid rgba(255,255,255,.06);
}
.footer-top{
display:flex;
justify-content:space-between;
align-items:center;
margin-bottom:50px;
flex-wrap:wrap;
gap:40px;
}
.footer-brand h2{
font-family:'Space Grotesk';
margin-bottom:8px;
}
.footer-brand p{
color:#8f8f8f;
}
.footer-links{
display:flex;
gap:35px;
flex-wrap:wrap;
}
.footer-links a{
transition:.3s;
}
.footer-links a:hover{
color:var(--gold);
}
.footer-social{
display:flex;
gap:20px;
}
.footer-social a{
width:50px;
height:50px;
display:flex;
align-items:center;
justify-content:center;
background:#111;
border-radius:50%;
border:1px solid #222;
transition:.35s;
font-size:20px;
}
.footer-social a:hover{
background:var(--gold);
color:#111;
transform:translateY(-5px);
}
.footer-bottom{
padding-top:35px;
border-top:1px solid rgba(255,255,255,.06);
text-align:center;
color:#888;
}

/*==========================================
SCROLL TOP
==========================================*/
#scroll-top{
position:fixed;
right:35px;
bottom:35px;
width:55px;
height:55px;
border-radius:50%;
background:var(--gold);
color:#111;
display:flex;
justify-content:center;
align-items:center;
font-size:22px;
cursor:pointer;
opacity:0;
visibility:hidden;
transition:.35s;
z-index:999;
}
#scroll-top.show{
opacity:1;
visibility:visible;
}

/*==========================================
UTILITY
==========================================*/
::selection{
background:var(--gold);
color:#111;
}
.primary-btn,
.secondary-btn,
.nav-btn{
cursor:pointer;
}
section{
position:relative;
overflow:hidden;
}



/*==================================================
RESPONSIVE.CSS
==================================================*/
/*==========================
1400px
==========================*/
@media (max-width:1400px){
.hero h1{
font-size:64px;
}
.section-heading h2{
font-size:48px;
}
.about-content h2{
font-size:52px;
}
}

/*==========================
1200px
==========================*/
@media (max-width:1200px){
.hero-grid{
gap:60px;
}
.project-card{
gap:50px;
}
.services-grid{
grid-template-columns:repeat(2,1fr);
}
.timeline{
grid-template-columns:repeat(2,1fr);
}
.testimonial-grid{
grid-template-columns:repeat(2,1fr);
}
}


/*==========================
992px
==========================*/
@media (max-width:992px){
nav{
display:none;
}
.nav-btn{
display:none;
}
#menu-btn{
display:block;
font-size:32px;
cursor:pointer;
}
.hero{
padding-top:150px;
}
.hero-grid{
grid-template-columns:1fr;
text-align:center;
}
.hero-left{
order:2;
}
.hero-right{
order:1;
}
.hero p{
margin:auto auto 45px;
}
.hero-buttons{
justify-content:center;
}
.hero-stats{
justify-content:center;
flex-wrap:wrap;
}
.floating-card{
display:none;
}
.project-card{
grid-template-columns:1fr;
}
.project-card.reverse{
direction:ltr;
}
.about-grid{
grid-template-columns:1fr;
}
.about-content{
text-align:center;
}
.about-content .primary-btn{
margin:auto;
}
.footer-top{
flex-direction:column;
text-align:center;
}
.footer-links{
justify-content:center;
}
.footer-social{
justify-content:center;
}
}

/*==========================
768px
==========================*/
@media (max-width:768px){
.section{
padding:90px 0;
}
.hero h1{
font-size:52px;
}
.section-heading h2{
font-size:40px;
}
.project-content h3{
font-size:34px;
}
.about-content h2{
font-size:42px;
}
.cta-box{
padding:60px 35px;
}
.cta-box h2{
font-size:42px;
}
.services-grid{
grid-template-columns:1fr;
}
.timeline{
grid-template-columns:1fr;
}
.testimonial-grid{
grid-template-columns:1fr;
}
.input-group{
grid-template-columns:1fr;
}
.hero-buttons{
flex-direction:column;
}
.primary-btn,
.secondary-btn{
width:100%;
text-align:center;
}
}

/*==========================
576px
==========================*/
@media (max-width:576px){
.container{
width:92%;
}
.logo{
font-size:22px;
}
.hero{
padding-top:130px;
}
.hero h1{
font-size:42px;
}
.hero p{
font-size:17px;
}
.hero-stats{
gap:25px;
}
.hero-stats h2{
font-size:34px;
}
.section-heading{
margin-bottom:50px;
}
.section-heading h2{
font-size:34px;
}
.project-content h3{
font-size:28px;
}
.about-content h2{
font-size:34px;
}
.cta-box h2{
font-size:34px;
}
.footer-links{
flex-direction:column;
gap:18px;
}
#scroll-top{
right:20px;
bottom:20px;
width:48px;
height:48px;
}
}
/*==========================
400px
==========================*/
@media (max-width:400px){
.hero h1{
font-size:36px;
}
.section-heading h2{
font-size:30px;
}
.about-content h2{
font-size:30px;
}
.hero-tag{
font-size:12px;
}
.primary-btn,
.secondary-btn{
padding:16px 22px;
}
}
